# ============================================================
# RapidRoute+ — Environment Variables Example
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual .env file to GitHub.
# ============================================================

# ---- Lovable Cloud / Supabase (auto-provisioned by Lovable Cloud) ----
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# ---- Google Maps Platform (browser-restricted key) ----
# Create at https://console.cloud.google.com/apis/credentials
# Restrict by HTTP referrer to your deployed domain(s).
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-browser-api-key"

# ---- Server-only secrets (DO NOT prefix with VITE_) ----
# These are configured inside Lovable Cloud → Backend → Secrets,
# never read from the client bundle.
# LOVABLE_API_KEY=...            # Lovable AI Gateway key (managed)
# SUPABASE_SERVICE_ROLE_KEY=...  # Server-only admin key (managed)
